# ==============================================================================
# Backlify Docker Environment Configuration
# ==============================================================================

# Database settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=backlify_db
POSTGRES_PORT=5433

# Redis settings
REDIS_PORT=6379

# Internal Docker Service URLs
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/backlify_db
REDIS_URL=redis://redis:6379 

# Cloud Storage (Cloudflare R2 / AWS S3 / MinIO)
STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=your_storage_access_key_id
STORAGE_SECRET_ACCESS_KEY=your_storage_secret_access_key
STORAGE_BUCKET=backlify

# Encryption (32-byte hex for database connection string security)
DATABASE_ENCRYPTION_KEY=your_64_character_hex_encryption_key
BACKUP_ENCRYPTION_KEY=your_64_character_hex_encryption_key

# Alerts & Notifications
RESEND_API_KEY=re_your_resend_api_key
APP_URL=http://localhost:3000

# Logging
LOG_LEVEL=info
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret