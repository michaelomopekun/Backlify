{
  "name": "backlify-cli",
  "version": "1.0.1",
  "type": "module",
  "description": "Developer-first CLI for Backlify — Database backups, recovery drills, and guarded migrations",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "backlify": "dist/bin/backlify.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/bin/backlify.js",
    "dev": "npx tsx bin/backlify.ts",
    "test": "npx tsx test/cli.test.ts"
  },
  "keywords": [
    "backlify",
    "cli",
    "database",
    "backup",
    "postgresql",
    "migrations",
    "dr-drills",
    "recovery"
  ],
  "author": "Backlify Team",
  "license": "ISC",
  "dependencies": {
    "commander": "^12.0.0",
    "conf": "^12.0.0",
    "dotenv": "^16.4.5",
    "execa": "^8.0.1",
    "picocolors": "^1.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "db": "*",
    "shared": "*",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
